# ==============================================================================
# Environment Configuration Template for Lab 19: GraphRAG vs Flat RAG
# Copy this file to .env and fill in your credentials: cp .env.example .env
# ==============================================================================

# --- Neo4j Database (Local Docker hoặc Neo4j AuraDB) ---
NEO4J_URI=neo4j+s://<your-instance-id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j

# --- Extraction & Generation LLM (Groq / OpenAI) ---
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# --- LLM-as-a-Judge Evaluation ---
JUDGE_PROVIDER=openai
JUDGE_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-...

# --- Hugging Face Access Token (để stream dataset HackerNoon) ---
HF_TOKEN=hf_...
